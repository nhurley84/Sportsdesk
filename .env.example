# .env.local — copy this to .env.local and fill in your values
# Never commit .env.local to git

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Secret key for the /api/refresh endpoint (generate a random string)
REFRESH_SECRET=change-this-to-a-random-secret-string

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL_SECONDS=900

# Your site URL (used for OG tags / sitemap)
NEXT_PUBLIC_SITE_URL=https://thesportsdesk.com.au

# Google Ad Manager publisher ID (get this from your GAM account)
# NEXT_PUBLIC_GAM_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
